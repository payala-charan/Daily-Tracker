<h2>Edit Expense</h2>

<%= form_with model: @expense, local: true do |f| %>

  <div>
    <%= f.label :category_id, "Category" %><br>
    <%= f.collection_select :category_id,
          @categories,
          :id,
          :name,
          { prompt: "Select Category" },
          { required: true } %>
  </div>

  <div>
    <%= f.label :amount %><br>
    <%= f.number_field :amount, step: 0.01, required: true %>
  </div>

  <br>
  <%= f.submit "Update Expense" %>

<% end %>

<br>
<%= link_to "Back to Expenses", expenses_path %>
