<style>
  :root {
    --primary: #4f46e5;
    --primary-light: #eef2ff;
    --success: #059669;
    --bg: #f8fafc;
    --card-bg: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
  }

  body { background: var(--bg); color: var(--text-main); font-family: 'Inter', system-ui, sans-serif; margin: 0; padding: 20px; }

  .layout-wrapper { max-width: 1000px; margin: 0 auto; }

  /* Top Section: Hero Bento Box */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  .glass-box {
    background: var(--card-bg);
    padding: 30px;
    border-radius: 24px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .header-area h1 { margin: 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px; }
  .date-badge { display: inline-block; background: var(--primary-light); color: var(--primary); padding: 6px 14px; border-radius: 100px; font-weight: 700; font-size: 0.85rem; margin-top: 10px; }

  /* Category List inside Hero */
  .category-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .chip { background: #f1f5f9; color: var(--text-muted); padding: 8px 16px; border-radius: 12px; font-size: 0.8rem; font-weight: 600; border: 1px solid transparent; }

  /* Sidebar Form Styling */
  .form-container h3 { margin-top: 0; font-size: 1.1rem; }
  .field { margin-bottom: 15px; }
  .field label { display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; }
  .field select, .field input { width: 100%; padding: 12px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 1rem; box-sizing: border-box; }
  .submit-btn { width: 100%; background: var(--primary); color: white; border: none; padding: 14px; border-radius: 10px; font-weight: 700; cursor: pointer; transition: 0.2s; }
  .submit-btn:hover { background: #4338ca; transform: translateY(-2px); }

  /* Activity Feed Layout */
  .activity-feed { background: var(--card-bg); border-radius: 24px; padding: 20px; border: 1px solid rgba(226, 232, 240, 0.8); }
  .feed-header { border-bottom: 1.5px solid #f1f5f9; padding-bottom: 15px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
  
  .expense-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border-radius: 16px;
    transition: 0.2s;
  }
  .expense-item:hover { background: #f8fafc; }
  .item-left { display: flex; align-items: center; gap: 15px; }
  .icon-circle { width: 44px; height: 44px; background: #f1f5f9; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
  .item-info b { display: block; font-size: 1rem; }
  .item-info small { color: var(--text-muted); font-size: 0.8rem; }
  .item-amount { font-weight: 800; color: var(--success); font-size: 1.1rem; }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="layout-wrapper">
  <div class="hero-grid">
    <div class="glass-box header-area">
      <h1>My Wallet Tracker 🪙</h1>
      <div class="date-badge"><%= Time.zone.now.strftime("%A, %d %B %Y") %></div>
      
      <div class="category-chips">
        <% @categories.each do |cat| %>
          <%= link_to edit_category_path(cat), class: "chip", style: "text-decoration:none;" do %>
            <%= cat.name %>
          <% end %>
        <% end %>

        <!-- Add Category Form (unchanged) -->
        <div class="chip" style="background: var(--primary-light); border: 1px dashed var(--primary);">
          <%= form_with model: Category.new,
                url: categories_path,
                local: true do |f| %>
            <%= f.text_field :name,
                  placeholder: "+ Add category",
                  style: "border:none; background:transparent; outline:none; width:120px;" %>
          <% end %>
        </div>
      </div>
      <div>
        <%= link_to "Analytics", analytics_path %>    
      </div>        

    </div>

    <div class="glass-box form-container">
      <h3>New Expense</h3>
      <%= form_with model: @expense, url: expenses_path do |f| %>
        <div class="field">
          <%= f.label :category_id, "Category" %>
          <%= f.collection_select :category_id,
                @categories,
                :id,
                :name,
                prompt: "Choose..." %>
        </div>

        <div class="field">
          <%= f.label :amount %>
          <%= f.number_field :amount, step: 0.01, placeholder: "₹ 0.00" %>
        </div>
        <%= f.submit "Save Transaction", class: "submit-btn" %>
      <% end %>
    </div>
  </div>  


  <div class="activity-feed">
    <div class="feed-header">
      <h2 style="margin:0; font-size: 1.2rem;">Transaction History</h2>
      <span style="color: var(--text-muted); font-size: 0.8rem;"><%= @expenses.count %> records</span>
    </div>

    
    
    <% @expenses.each do |expense| %>
      <div class="expense-item">
        <div class="item-left">
          <div class="icon-circle">
            <%# Simple logic to show different icons based on category name %>
            <%= case expense.category&.name&.downcase
                when /food/ then "🍕"
                when /rent/ then "🏠"
                when /travel|transport/ then "🚗"
                when /shopping/ then "🛍️"
                else "💰" end %>
          </div>
          <div class="item-info">
            <b><%= expense.category&.name %></b>
            <small><%= expense.created_at.strftime("%I:%M %p • %d %b") %></small>
          </div>
        </div>
        <div>
            <%= link_to "Edit", edit_expense_path(expense), class: "btn-edit" %>
            <%= button_to "Delete",
                    expense_path(expense),
                    method: :delete,
                    data: { confirm: "Are you sure?" },
                    class: "btn-delete" 
                %>
        </div>    
        <div class="item-amount">
          ₹<%= number_with_precision(expense.amount, precision: 2) %>
        </div>
      </div>
    <% end %>
  </div>
</div>