# <link rel="stylesheet" href="dashboard.css">
<h1>Welcome, <%= current_user.name %> 👋</h1>
<div class="dashboard-container">
  <div class="calendar-box">
    <h2><%= @today.strftime("%B %Y") %></h2>

    <div class="calendar-grid">
      <% (@current_month..@end_of_month).each do |date| %>
        <% is_today = date == @today %>

        <div class="calendar-day <%= 'today' if is_today %>">
          <%= date.day %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<p>This is your dashboard.</p>
<ul>
  <li><%= link_to "Expense Tracker", expenses_path %></li>
  <li><%= link_to "Set Targets", targets_path %></li>
  <li><%= link_to "Notes", notes_path %></li>
  <li><%= link_to "Meetings", meetings_path %></li>
  <li><%= link_to "Budget Planning", balance_path %></li>
  <li><%= link_to "Analytics", analytics_path %></li>
  <li><%= link_to "Files", uploaded_files_path %></li>
  <li><%= link_to "Habits", habits_dashboard_path %></li>
</ul>

