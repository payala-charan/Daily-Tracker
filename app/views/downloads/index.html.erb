<!-- app/views/downloads/index.html.erb -->
<h2>Download Data</h2>

<%= form_with url: downloads_export_path,
              method: :get,
              local: true,
              data: { turbo: false } do %>

  <div>
    <label>Data Type</label>
    <%= select_tag :data_type,
        options_for_select([
          ["Income", "income"],
          ["Expense", "expense"],
          ["Expenditure", "expenditure"]
        ]) %>
  </div>

  <div>
    <label>File Type</label>
    <%= select_tag :file_type,
        options_for_select([
          ["Excel", "excel"],
          ["PDF", "pdf"]
        ]) %>
  </div>

  <%= submit_tag "Download" %>

<% end %>
